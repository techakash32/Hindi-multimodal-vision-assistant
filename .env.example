# Copy to .env and fill in. Keys are only needed for "read text" (OCR.space)
# and "describe scene" (OpenRouter). Detection, speech and voice commands work without them.

# Free key from https://ocr.space/ocrapi/freekey
OCR_API_KEY=

# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Keep every frame on the device (local Tesseract OCR, no cloud scene description or translation)
LOCAL_ONLY=false

# Hindi-only voice and screen text (recommended)
HINDI_ONLY=true

# Camera and detection
CAMERA_INDEX=0
YOLO_IMGSZ=320

# Dashboard. Set WEB_TOKEN before exposing it on a network (--host 0.0.0.0).
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_TOKEN=
